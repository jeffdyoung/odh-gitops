{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ai-grid-o11y-hub values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "description": "Global values Helm passes to every subchart."
    },
    "enabled": {
      "type": "boolean"
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63
    },
    "createNamespace": {
      "type": "boolean"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "lokiStack": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "size": {
          "type": "string",
          "enum": [
            "1x.demo",
            "1x.pico",
            "1x.extra-small",
            "1x.small",
            "1x.medium"
          ]
        },
        "storageClassName": {
          "type": "string",
          "minLength": 1
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "enum": [
                  "v11",
                  "v12",
                  "v13"
                ]
              },
              "effectiveDate": {
                "type": "string"
              }
            },
            "required": [
              "version",
              "effectiveDate"
            ],
            "additionalProperties": false
          }
        },
        "limits": {
          "type": "object"
        },
        "template": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "size",
        "storageClassName",
        "schemas"
      ],
      "additionalProperties": false
    },
    "objectStorage": {
      "type": "object",
      "properties": {
        "secretName": {
          "type": "string"
        },
        "secret": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "bucketNames": {
              "type": "string"
            },
            "endpoint": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "accessKeyId": {
              "type": "string"
            },
            "accessKeySecret": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "obc": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "generateBucketName": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "serviceCA": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "configMapName": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ingest": {
      "type": "object",
      "properties": {
        "writer": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "serviceAccountName": {
              "type": "string",
              "maxLength": 253
            }
          },
          "additionalProperties": false
        },
        "reader": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "serviceAccountName": {
              "type": "string",
              "maxLength": 253
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
